{
  "name": "local-lite-server",
  "version": "0.1.7",
  "description": "Self-hostable local-lite sync server for MySQL or Postgres. Runs on cPanel Node.js apps or any VPS, no Docker.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "local-lite-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/cpanel/**",
    "admin/dist",
    "skills",
    "templates",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cpanel": "npm run build && node scripts/build-cpanel.mjs",
    "prestart": "npm run build",
    "dev": "node scripts/dev.mjs",
    "dev:admin": "npm --prefix admin run dev",
    "start": "node --env-file-if-exists=.env dist/cli.js start",
    "migrate": "node --env-file-if-exists=.env dist/cli.js migrate",
    "test": "vitest run"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "local-lite": "^3.3.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
