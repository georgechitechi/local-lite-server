{
  "name": "local-lite-server",
  "version": "0.1.10",
  "description": "Local-first SQL sync & command engine for MySQL and PostgreSQL. Zero Docker.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "local-lite-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "dashboard/dist",
    "skills",
    "templates",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm --prefix dashboard run build",
    "build:dashboard": "npm --prefix dashboard run build",
    "prestart": "npm run build",
    "dev": "node scripts/dev.mjs",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "start": "node --env-file-if-exists=.env dist/cli.js start",
    "migrate": "node --env-file-if-exists=.env dist/cli.js migrate",
    "test": "vitest run"
  },
  "dependencies": {
    "local-lite": "^3.3.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
