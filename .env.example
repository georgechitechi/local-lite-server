# Port. On cPanel/Passenger the platform provides PORT automatically.
SERVER_PORT=3000

# Database: DB_DIALECT=mysql | postgres
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# DB_SSL=true
DB_POOL_SIZE=5

# Apply core + schema.ts changes on boot (recommended on cPanel).
# When false, run `npm run migrate` yourself; the server only warns about pending changes.
AUTO_MIGRATE=true
# Your table definitions (default: ./schema.ts, schema.mjs, schema.js or schema.json).
# SCHEMA_PATH=./schema.ts
# Server functions folder (default: ./functions).
# FUNCTIONS_DIR=./functions

# Clients send this as "Authorization: Bearer <key>". Generate a long random value.
SERVER_API_KEY=change-me

# Enables user accounts (/auth/*) and signs their tokens. Use a long random value.
# Leave unset to allow only the SERVER_API_KEY.
APP_SECRET=
APP_NAME=local-lite-server

# Built-in admin page at /admin (needs SERVER_API_KEY to use). Set false to disable.
ADMIN_UI=true

# SMTP for password-reset emails (optional).
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=
# SMTP_FROM=My App <no-reply@yourdomain.com>

# Comma-separated allowed origins for CORS, or * for all.
CORS_ORIGINS=*
