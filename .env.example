# Server bind host and port.
# Use 0.0.0.0 to accept LAN / physical mobile device connections.
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Database: DB_DIALECT=mysql | postgres
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# DB_SSL=true
DB_POOL_SIZE=5

# Apply core + schema.ts changes on boot (advisory-locked across instances).
# When false, run `npm run migrate` yourself; the server only warns about pending changes.
AUTO_MIGRATE=true
# SCHEMA_PATH=./schema.ts
# RULES_PATH=./rules.ts
# COMMANDS_DIR=./commands
# ROUTES_PATH=./routes.ts

# Master API key (Authorization: Bearer <key>). Generate a long random value.
SERVER_API_KEY=change-me

# Enables user accounts (/auth/*) and signs their tokens. Use a long random value.
# Leave unset to allow only API keys.
APP_SECRET=
APP_NAME=local-lite-server

# OAuth code exchange secrets (optional; for POST /auth/google-token & /auth/github-token).
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_SECRET=

# SMTP for password-reset emails (optional).
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=
# SMTP_FROM=My App <no-reply@yourdomain.com>

# DB-native multi-instance pub/sub (Postgres LISTEN/NOTIFY or MySQL _server_changes tailing).
# MULTI_INSTANCE=true

# Built-in React dashboard at /dashboard (set false to disable).
DASHBOARD_ENABLED=true

# Comma-separated allowed origins for CORS, or * for all.
CORS_ORIGINS=*
