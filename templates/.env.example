# Server bind host and port. Use 0.0.0.0 for LAN / physical mobile device connections.
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Database: mysql | postgres
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=local_lite
# DB_SSL=true
DB_POOL_SIZE=5

# Migrations & custom paths
AUTO_MIGRATE=true
# SCHEMA_PATH=./src/schema.ts
# RULES_PATH=./src/rules.ts
# FUNCTIONS_DIR=./src/functions
# ROUTES_PATH=./src/routes.ts

# Storage & backups
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# Auth & Admin Console
SERVER_API_KEY=change-me
APP_SECRET=change-me
APP_NAME={{PKG_NAME}}
ADMIN_UI=true

# OAuth code exchange (optional: POST /auth/google-token & /auth/github-token)
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_SECRET=

# SMTP for password-reset emails (optional)
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=
# SMTP_FROM={{PKG_NAME}} <no-reply@yourdomain.com>

# Background crons & multi-instance sync (optional)
# ENABLE_INTERNAL_CRONS=true
# MULTI_INSTANCE=true

# CORS
CORS_ORIGINS=*
